<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050505">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Second Chance Legacy Family OS</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <style>
    :root{--black:#050505;--panel:#0d0d0d;--panel2:#151515;--gold:#d3ad54;--gold2:#f4dc95;--green:#0c6f45;--cream:#f5edda;--muted:#b9af9a;--line:#554621;--danger:#dc7474;--success:#9fe0bd;--info:#9fc8e0}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;color:var(--cream);font-family:Arial,Helvetica,sans-serif;background:linear-gradient(rgba(0,0,0,.88),rgba(0,0,0,.94)),url("crest.jpg") center/cover fixed no-repeat,var(--black)}button,input,select,textarea{font:inherit}button{cursor:pointer}[hidden]{display:none!important}a{color:var(--gold2)}
    .auth-shell{min-height:100vh;display:grid;place-items:center;padding:24px}.auth-card{width:min(100%,540px);padding:30px;border:1px solid var(--line);border-radius:24px;background:rgba(7,7,7,.97);box-shadow:0 30px 90px rgba(0,0,0,.62)}.auth-logo{display:block;width:min(290px,72vw);margin:0 auto 18px}.auth-card h1{margin:0;color:var(--gold2);font:700 clamp(32px,7vw,50px)/1.02 Georgia,serif;text-align:center}.subtitle{text-align:center;color:var(--muted);line-height:1.6;margin:12px 0 25px}.field{margin-bottom:14px}.field label{display:block;margin-bottom:7px;color:#e6d9bb;font-size:13px;font-weight:700}.control,input,select,textarea{width:100%;padding:12px 13px;color:#fff;background:#111;border:1px solid #5d4d2a;border-radius:10px;outline:none}textarea{min-height:105px;resize:vertical}input:focus,select:focus,textarea:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(211,173,84,.13)}
    .btn{border-radius:10px;padding:11px 14px;font-weight:700;border:1px solid transparent}.btn-primary{color:#111;background:var(--gold2);border-color:var(--gold)}.btn-secondary{color:var(--gold2);background:#111;border-color:var(--gold)}.btn-green{color:#eafff3;background:#0b3825;border-color:#32805b}.btn-danger{color:#ffd0d0;background:#2a1010;border-color:#8b4141}.btn-ghost{color:#ded5c4;background:transparent;border-color:#3c321d}.btn-wide{width:100%}.link-btn{width:100%;margin-top:12px;border:0;background:transparent;color:var(--gold2)}button:disabled{opacity:.55;cursor:not-allowed}.notice,.error,.warning{margin:13px 0;padding:12px 14px;border-radius:10px;line-height:1.5}.notice{color:#b9e5cc;background:#0b2418;border:1px solid #3b6c55}.error{color:#ffd2d2;background:#291010;border:1px solid #814242}.warning{color:#ffe3a4;background:#2b2009;border:1px solid #8e6e21}.small{color:#928977;font-size:12px;line-height:1.55}
    .app{min-height:100vh;display:grid;grid-template-columns:300px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;overflow:auto;padding:17px 14px;background:rgba(6,6,6,.98);border-right:1px solid var(--line)}.brand{display:flex;gap:12px;align-items:center;padding:5px 5px 16px;border-bottom:1px solid #2d2616}.brand img{width:64px;height:76px;object-fit:contain}.brand strong{display:block;color:var(--gold2);font:700 16px Georgia,serif;letter-spacing:.05em}.brand small{color:var(--muted)}.nav-search{margin:14px 0}.nav{display:grid;gap:6px}.nav button{display:flex;align-items:center;gap:9px;width:100%;padding:10px 11px;text-align:left;color:#d8cfbe;background:transparent;border:1px solid transparent;border-radius:9px}.nav button:hover,.nav button.active{color:#fff;border-color:var(--line);background:linear-gradient(135deg,rgba(211,173,84,.18),rgba(13,112,70,.13))}.nav-icon{width:20px;color:var(--gold);text-align:center}.account-card{margin-top:20px;padding:13px;border:1px solid #302918;border-radius:11px;background:#0b0b0b;overflow-wrap:anywhere}.account-card strong{display:block;color:var(--gold2);margin-bottom:4px}.role-badge,.chip{display:inline-block;padding:5px 8px;border-radius:999px;font-size:11px}.role-badge{margin-top:8px;color:var(--success);background:#0b2418;border:1px solid #2d7654;text-transform:uppercase}.content{min-width:0;padding:24px}.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:20px}.topbar h1{margin:0;color:var(--gold2);font:700 clamp(27px,4vw,42px) Georgia,serif}.topbar p{margin:6px 0 0;color:var(--muted)}.secure-pill{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;color:var(--success);background:#0b2418;border:1px solid #2d7654;border-radius:999px;font-size:12px;white-space:nowrap}
    .panel,.hero{padding:clamp(22px,4vw,42px);border:1px solid var(--line);border-radius:18px;background:rgba(8,8,8,.93)}.hero h2,.panel h2{margin:7px 0 14px;color:var(--gold2);font:700 clamp(30px,5vw,54px) Georgia,serif}.eyebrow{color:var(--gold);font-size:12px;text-transform:uppercase;letter-spacing:.16em}.lead{color:#d0c6b2;line-height:1.75}.quote{margin-top:20px;padding:18px;color:#f0dc9d;background:#060606;border-left:4px solid var(--gold);font:italic 20px/1.5 Georgia,serif}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.metric,.card,.record-card,.doc-card{padding:18px;border:1px solid var(--line);border-radius:13px;background:linear-gradient(180deg,#151515,#0a0a0a)}.metric strong{display:block;color:var(--gold2);font:700 34px Georgia,serif}.metric span{color:var(--muted);font-size:13px}.card h3,.record-card h3,.doc-card h3{margin:0 0 8px;color:var(--gold2);font-family:Georgia,serif}.card p,.record-card p,.doc-card p{color:#c9bfac;line-height:1.55;margin:6px 0}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:18px 0}.toolbar-group{display:flex;gap:9px;flex-wrap:wrap}.toolbar input,.toolbar select{width:auto;min-width:190px}.records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.meta{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0}.chip{color:#d9ca9e;background:#15120a;border:1px solid #514623}.chip-green{color:var(--success);background:#0b2418;border-color:#2d7654}.chip-red{color:#ffd0d0;background:#2a1010;border-color:#8b4141}.chip-blue{color:#cceafa;background:#102430;border-color:#3b6a82}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.empty{padding:28px;text-align:center;color:var(--muted);border:1px dashed #5d4d2a;border-radius:13px;background:rgba(8,8,8,.8)}.section-title{margin:26px 0 12px;color:var(--gold2);font:700 25px Georgia,serif}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}.data-table{width:100%;border-collapse:collapse;min-width:720px;background:#0a0a0a}.data-table th,.data-table td{padding:12px 13px;border-bottom:1px solid #2c2618;text-align:left;vertical-align:top}.data-table th{color:var(--gold2);background:#111;font-size:12px;text-transform:uppercase;letter-spacing:.05em}.data-table td{color:#d2c9b8;font-size:13px}.progress{height:10px;background:#1a1a1a;border:1px solid #3f351d;border-radius:999px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--green),var(--gold));}.check-row{display:flex;gap:12px;align-items:flex-start;padding:14px;border:1px solid #3d341f;border-radius:11px;background:#0b0b0b}.check-row input{width:20px;height:20px;margin-top:2px}.check-row.completed{border-color:#2d7654;background:#0b1c13}.footer{padding:28px 0 7px;text-align:center;color:#776e5f;font-size:12px}
    .modal-backdrop{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:18px;background:rgba(0,0,0,.78);backdrop-filter:blur(4px)}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;padding:23px;border:1px solid var(--line);border-radius:17px;background:#0a0a0a;box-shadow:0 30px 90px #000}.modal h2{margin:0 0 15px;color:var(--gold2);font-family:Georgia,serif}.modal-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.modal-close{border:0;background:transparent;color:#fff;font-size:26px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.form-grid .wide{grid-column:1/-1}.detail-list{display:grid;grid-template-columns:180px minmax(0,1fr);gap:8px 14px}.detail-list dt{color:var(--gold2);font-weight:700}.detail-list dd{margin:0;color:#d2c8b4;overflow-wrap:anywhere}.toast{position:fixed;right:18px;bottom:18px;z-index:80;max-width:420px;padding:14px 16px;border-radius:11px;color:#eafff3;background:#0b3825;border:1px solid #32805b;box-shadow:0 14px 50px #000}.loading{display:inline-block;width:18px;height:18px;border:2px solid #594b2c;border-top-color:var(--gold2);border-radius:50%;animation:spin .75s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
    @media(max-width:1050px){.grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:900px){.app{grid-template-columns:1fr}.sidebar{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--line)}.nav{grid-template-columns:repeat(2,minmax(0,1fr))}.content{padding:16px}}@media(max-width:650px){.grid,.grid-3,.records,.form-grid{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}.topbar{flex-direction:column}.toolbar input,.toolbar select{width:100%}.toolbar-group{width:100%}.detail-list{grid-template-columns:1fr}.nav{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <section class="auth-shell" id="authShell">
    <div class="auth-card">
      <img src="crest-transparent.png" alt="Second Chance Legacy Crest" class="auth-logo">
      <h1>SECOND CHANCE LEGACY</h1>
      <p class="subtitle" id="authSubtitle">Private Family Operating System · Production v2.0</p>
      <div id="authMessage"></div>
      <form id="loginForm">
        <div class="field"><label for="loginEmail">Email address</label><input id="loginEmail" type="email" autocomplete="email" required></div>
        <div class="field"><label for="loginPassword">Password</label><input id="loginPassword" type="password" autocomplete="current-password" minlength="16" required></div>
        <div id="captchaHost" class="field" hidden><label>Security check</label><div id="turnstileWidget"></div></div>
        <button class="btn btn-primary btn-wide" type="submit">Enter Family OS</button>
        <button class="link-btn" type="button" id="forgotBtn">Forgot password?</button>
      </form>
      <form id="passwordForm" hidden>
        <div class="notice">Create a private password to activate or recover your invited account.</div>
        <div class="field"><label for="newPassword">New password</label><input id="newPassword" type="password" autocomplete="new-password" minlength="16" required></div>
        <div class="field"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" type="password" autocomplete="new-password" minlength="16" required></div>
        <button class="btn btn-primary btn-wide" type="submit">Activate My Account</button>
        <p class="small">Use at least 16 characters. Do not reuse a banking, email, or social-media password.</p>
      </form>
    </div>
  </section>

  <div class="app" id="appShell" hidden>
    <aside class="sidebar">
      <div class="brand"><img src="crest-transparent.png" alt=""><div><strong>SECOND CHANCE LEGACY</strong><small>Family OS · v2.0</small></div></div>
      <div class="nav-search"><input id="globalSearch" type="search" placeholder="Search the Family OS"></div>
      <nav class="nav" id="nav"></nav>
      <div class="account-card">
        <strong id="accountName">Authorized Family Member</strong>
        <span id="accountEmail"></span><br>
        <span class="role-badge" id="accountRole">Loading role</span>
        <button class="btn btn-danger btn-wide" id="logoutBtn" style="margin-top:12px">Sign Out</button>
      </div>
    </aside>
    <main class="content">
      <header class="topbar"><div><h1 id="pageTitle">Command Center</h1><p id="pageDescription"></p></div><span class="secure-pill">● Secure Session Active</span></header>
      <div id="pageHost"><div class="panel"><span class="loading"></span> Loading Family OS…</div></div>
      <footer class="footer">SECOND CHANCE LEGACY FAMILY OPERATING SYSTEM · PRODUCTION v2.0 · PRIVATE & INVITE-ONLY</footer>
    </main>
  </div>

  <div class="modal-backdrop" id="recordModal" hidden><div class="modal"><div class="modal-head"><h2 id="recordModalTitle">Add Record</h2><button class="modal-close" data-close="recordModal">×</button></div><form id="recordForm"><div class="form-grid" id="recordFormFields"></div><div class="actions"><button class="btn btn-primary" type="submit">Save Record</button><button class="btn btn-ghost" type="button" data-close="recordModal">Cancel</button></div></form></div></div>
  <div class="modal-backdrop" id="documentModal" hidden><div class="modal"><div class="modal-head"><h2 id="documentModalTitle">Upload Private Document</h2><button class="modal-close" data-close="documentModal">×</button></div><form id="documentForm"><div class="form-grid" id="documentFormFields"></div><div class="actions"><button class="btn btn-primary" id="documentSubmitBtn" type="submit">Upload Securely</button><button class="btn btn-ghost" type="button" data-close="documentModal">Cancel</button></div></form><div id="documentModalMessage"></div></div></div>
  <div class="modal-backdrop" id="detailModal" hidden><div class="modal"><div class="modal-head"><h2 id="detailModalTitle">Record Details</h2><button class="modal-close" data-close="detailModal">×</button></div><div id="detailModalBody"></div></div></div>
  <div class="modal-backdrop" id="deviceModal" hidden><div class="modal" style="max-width:520px"><h2>Verify This New Device</h2><p class="lead">A six-digit code was sent to your account email. Enter it below to trust this browser.</p><div class="field"><label for="deviceCode">Verification code</label><input id="deviceCode" inputmode="numeric" maxlength="6"></div><button class="btn btn-primary btn-wide" id="verifyDeviceBtn">Verify Device</button><div id="deviceMessage"></div></div></div>
  <div class="toast" id="toast" hidden></div>

<script>
const CONFIG={
  supabaseUrl:'https://nvwhqvnzzbdiwdbterxd.supabase.co',
  publishableKey:'sb_publishable_Qzq84lME6MJInbtqQ-g5Hg_Oby6rqDx',
  siteUrl:'https://marquisescott73-bit.github.io/second-chance-legacy-os/',
  bucket:'family-vault',
  defaultIdleMinutes:30,
  defaultSignedSeconds:60,
  turnstileSiteKey:'' // Paste the public Cloudflare Turnstile site key here before enabling CAPTCHA in Supabase.
};
const MODULES=[{"key": "dashboard", "title": "Command Center", "icon": "⌂", "special": "dashboard", "description": "One secure view of the family’s governance, Trust, business, assets, deadlines, records, security, and legacy progress."}, {"key": "mission_values", "title": "Mission & Values", "icon": "◆", "description": "The purpose, vision, principles, values, responsibilities, and official statements guiding every generation.", "recordTypes": ["mission", "vision", "core_value", "core_principle", "family_standard"], "fields": [["principle_type", "Principle type", "text"], ["owner", "Steward or owner", "text"], ["review_frequency", "Review frequency", "text"]], "highlights": ["Family Before Ego", "Ownership Over Excuses", "Build, Don’t Only Consume", "Protect the Legacy"]}, {"key": "family_governance", "title": "Family Governance", "icon": "⚖", "description": "How authority is shared, major decisions are approved, duties are divided, and formal family decisions are recorded.", "recordTypes": ["authority_structure", "major_decision", "family_policy", "delegation", "decision_register"], "fields": [["decision_type", "Decision type", "text"], ["scope", "Scope", "text"], ["proposed_by", "Proposed by", "text"], ["supporting_document", "Supporting document", "text"]], "dualDefault": true, "highlights": ["Equal Joint Authority", "Both Written Approvals", "No Unilateral Final Control", "Permanent Decision Register"]}, {"key": "trust_succession", "title": "Trust & Succession", "icon": "♜", "description": "The active Trust structure, Co-Trustees, beneficiaries, successor trustees, asset schedules, incapacity, and continuity instructions.", "recordTypes": ["trust_overview", "trust_asset", "successor_trustee", "beneficiary", "incapacity_plan", "death_checklist", "amendment_record"], "fields": [["legal_status", "Legal status", "text"], ["grantors", "Grantors / Trustors", "text"], ["trustees", "Trustees", "text"], ["successor_priority", "Successor priority", "text"], ["asset_funding_status", "Asset funding status", "text"]], "dualDefault": true, "highlights": ["Joint Grantors", "Equal Co-Trustees", "Successor Planning", "Trust Asset Schedule"]}, {"key": "businesses", "title": "Businesses", "icon": "▣", "description": "Family-owned entities, ownership, managers, compliance, contracts, licenses, insurance, operations, and succession.", "recordTypes": ["business_profile", "ownership_record", "manager_role", "compliance_item", "contract", "license", "sop", "training_module"], "fields": [["legal_name", "Legal or official name", "text"], ["entity_type", "Entity type", "text"], ["ownership", "Ownership structure", "text"], ["manager", "Manager / responsible person", "text"], ["compliance_date", "Compliance or renewal date", "date"]], "dualDefault": true, "highlights": ["Trust-Owned LLC", "Operating Documents", "Compliance Calendar", "Staff Systems"]}, {"key": "assets", "title": "Assets", "icon": "◇", "description": "A complete registry of real estate, vehicles, businesses, accounts, heirlooms, equipment, intellectual property, and other family assets.", "recordTypes": ["real_estate", "vehicle", "bank_account", "investment", "retirement", "business_interest", "heirloom", "equipment", "digital_asset", "other_asset"], "fields": [["asset_type", "Asset type", "text"], ["legal_owner", "Legal owner", "text"], ["trust_status", "Trust status", "text"], ["estimated_value", "Estimated value", "number"], ["institution", "Institution or location", "text"], ["account_ending", "Account or identifier ending digits", "text"]], "highlights": ["Legal Ownership", "Trust Funding Status", "Supporting Titles", "Annual Verification"]}, {"key": "insurance", "title": "Insurance", "icon": "✚", "description": "Life, auto, home, business, workers’ compensation, umbrella, disability, key-person, and other family coverage.", "recordTypes": ["life", "health", "auto", "home_renters", "business_liability", "workers_comp", "umbrella", "disability", "key_person", "other"], "fields": [["policy_type", "Policy type", "text"], ["carrier", "Carrier", "text"], ["insured", "Insured person / property", "text"], ["coverage_amount", "Coverage amount", "number"], ["premium", "Premium", "number"], ["renewal_date", "Renewal date", "date"], ["beneficiary", "Beneficiary", "text"]], "highlights": ["Coverage Register", "Renewal Alerts", "Beneficiary Review", "Claims Contacts"]}, {"key": "financial_administration", "title": "Financial Administration", "icon": "$", "description": "Business tax reserves, financial summaries, tax records, debt administration, payroll records, professionals, and reporting.", "recordTypes": ["tax_record", "tax_reserve", "financial_summary", "debt_record", "payroll_record", "professional_contact", "budget", "cash_flow"], "fields": [["period", "Reporting period", "text"], ["amount", "Amount", "number"], ["reserve_bucket", "Reserve bucket", "text"], ["institution_or_professional", "Institution / professional", "text"], ["due_date", "Due date", "date"]], "dualDefault": true, "highlights": ["Business Tax Reserve", "Personal Estimate Buckets", "Financial Reports", "Restricted Access"]}, {"key": "family_members", "title": "Family Members", "icon": "●", "description": "Respectful family profiles, roles, milestones, education goals, successor responsibilities, and protected-record references.", "recordTypes": ["adult_profile", "youth_profile", "milestone", "education_goal", "family_role", "successor_responsibility"], "fields": [["legal_name", "Full legal name", "text"], ["preferred_name", "Preferred name", "text"], ["relationship", "Relationship", "text"], ["birth_date", "Date of birth", "date"], ["family_role", "Family role", "text"], ["emergency_contact", "Emergency contact", "text"]], "highlights": ["Controlled Profiles", "Protected Identity Files", "Milestones", "Age-Appropriate Access"]}, {"key": "family_history", "title": "Family History", "icon": "⌛", "description": "Family tree, ancestry, migration stories, oral histories, photographs, nicknames, community contributions, and source records.", "recordTypes": ["person_story", "family_line", "place_history", "oral_history", "photo_record", "timeline_event", "source_record"], "fields": [["person_or_family_line", "Person or family line", "text"], ["place", "Place", "text"], ["date_period", "Date or period", "text"], ["source", "Source", "text"], ["permission_status", "Permission status", "text"]], "highlights": ["Family Tree", "Oral Histories", "Source Citations", "Photographs & Media"]}, {"key": "legacy_book", "title": "Legacy Book", "icon": "▤", "description": "The working and final chapters of the Second Chance Legacy family book, letters, contributors, approvals, and publication history.", "recordTypes": ["chapter", "letter", "interview_excerpt", "publication_version", "editorial_note"], "fields": [["chapter_number", "Chapter number", "text"], ["contributor", "Contributor", "text"], ["version", "Version", "text"], ["review_status", "Review status", "text"], ["publication_date", "Publication date", "date"]], "highlights": ["Chapter Control", "Contributor History", "Publication Versions", "Letters Forward"]}, {"key": "traditions_recipes", "title": "Traditions & Recipes", "icon": "✦", "description": "Family recipes, holidays, birthdays, Sunday routines, celebrations, sayings, playlists, photos, and cultural traditions.", "recordTypes": ["recipe", "holiday_tradition", "birthday_tradition", "family_routine", "family_saying", "celebration", "playlist"], "fields": [["associated_person", "Associated family member", "text"], ["event_or_holiday", "Event or holiday", "text"], ["prep_time", "Preparation time", "text"], ["story", "Story behind it", "textarea"], ["media_reference", "Photo, video, or QR reference", "text"]], "highlights": ["Recipes With Stories", "Annual Traditions", "Family Sayings", "Photos & Videos"]}, {"key": "education_library", "title": "Education Library", "icon": "△", "description": "Age-appropriate financial, business, ownership, legal, life-skill, health, home, vehicle, and relationship lessons.", "recordTypes": ["financial_lesson", "business_lesson", "life_skill", "ownership_lesson", "home_vehicle", "health_discipline", "relationship_lesson", "resource"], "fields": [["topic", "Topic", "text"], ["audience", "Audience", "text"], ["level", "Level", "text"], ["resource_type", "Resource type", "text"], ["completion_standard", "Completion standard", "text"]], "highlights": ["Financial Literacy", "Business Ownership", "Life Skills", "Lessons Learned"]}, {"key": "emergency_center", "title": "Emergency Center", "icon": "!", "description": "Actionable plans and contacts for death, incapacity, fire, disaster, medical emergencies, fraud, lost identity, and business interruption.", "recordTypes": ["emergency_contact", "death_plan", "incapacity_plan", "fire_disaster", "medical_plan", "fraud_plan", "lost_identity", "business_continuity"], "fields": [["plan_type", "Plan type", "text"], ["activation_condition", "Activation condition", "text"], ["primary_contact", "Primary contact", "text"], ["secondary_contact", "Secondary contact", "text"], ["review_frequency", "Review frequency", "text"]], "dualDefault": true, "highlights": ["Crisis Checklists", "Professional Contacts", "Break-Glass Procedure", "Annual Testing"]}, {"key": "digital_estate", "title": "Digital Estate", "icon": "@", "description": "A directory of digital accounts, owners, recovery methods, MFA methods, password-manager locations, and successor instructions—without storing raw passwords.", "recordTypes": ["email", "financial_portal", "domain_hosting", "social_media", "cloud_storage", "business_software", "subscription", "crypto", "other_account"], "fields": [["service_name", "Service name", "text"], ["account_owner", "Account owner", "text"], ["recovery_email", "Recovery email", "email"], ["mfa_method", "MFA method", "text"], ["password_location", "Where password is stored", "text"], ["successor_instructions", "Successor instructions", "textarea"]], "dualDefault": true, "highlights": ["No Raw Passwords", "Recovery Directory", "MFA Record", "Successor Instructions"]}, {"key": "private_vault", "title": "Private Vault", "icon": "▰", "special": "vault", "description": "Private file storage with metadata, temporary signed links, access classifications, checksums, versioning, and approval status."}, {"key": "family_meetings", "title": "Family Meetings", "icon": "◉", "description": "Annual meetings, Trust reviews, business reviews, agendas, decisions, assigned tasks, signed minutes, and follow-up dates.", "recordTypes": ["annual_meeting", "trust_review", "business_review", "financial_review", "emergency_review", "legacy_meeting", "goal_meeting"], "fields": [["meeting_date", "Meeting date", "date"], ["meeting_type", "Meeting type", "text"], ["attendees", "Attendees", "text"], ["decisions", "Decisions", "textarea"], ["assigned_tasks", "Assigned tasks", "textarea"], ["follow_up_date", "Follow-up date", "date"]], "highlights": ["Agenda & Minutes", "Decisions", "Assigned Tasks", "Follow-Up Dates"]}, {"key": "goals_projects", "title": "Goals & Projects", "icon": "✓", "description": "Homeownership, business, debt, savings, education, health, travel, history, Trust funding, property, and community goals.", "recordTypes": ["homeownership", "business_growth", "debt_reduction", "emergency_savings", "education", "health", "travel", "trust_funding", "property", "community_service", "legacy_project"], "fields": [["goal_owner", "Goal owner", "text"], ["contributors", "Contributors", "text"], ["target_date", "Target date", "date"], ["budget", "Budget", "number"], ["progress_percent", "Progress percent", "number"], ["next_action", "Next action", "textarea"]], "highlights": ["Clear Ownership", "Target Dates", "Budget & Progress", "Lessons Learned"]}, {"key": "document_register", "title": "Document Register", "icon": "≡", "special": "documents", "description": "The master index for active, executed, pending, superseded, historical, expired, and archived records."}, {"key": "administration", "title": "Administration", "icon": "⚙", "special": "admin", "description": "Joint-authority seats, invite approvals, user roles, account status, professional access expiration, and Family OS settings."}, {"key": "security_audit", "title": "Security & Audit", "icon": "◈", "special": "security", "description": "Login events, device records, document activity, role changes, audit history, session controls, and security configuration."}, {"key": "backups", "title": "Backups", "icon": "⇩", "special": "backups", "description": "Database and vault backup records, encrypted/offline locations, verification, and restore-test history."}, {"key": "annual_review", "title": "Annual Review", "icon": "☑", "special": "annual", "description": "One guided yearly review of the Trust, business, assets, insurance, security, backups, binder, history, and next priorities."}];
const MODULE_MAP=Object.fromEntries(MODULES.map(m=>[m.key,m]));
const sb=window.supabase.createClient(CONFIG.supabaseUrl,CONFIG.publishableKey,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});

let currentUser=null,currentProfile=null,currentModule='dashboard',settings={},founderSeats=[],currentRecords=[],currentDocuments=[],editingRecord=null,versionSource=null,idleTimer=null,pendingDeviceId=null,captchaToken=null,captchaWidgetId=null;
const $=id=>document.getElementById(id);
const authShell=$('authShell'),appShell=$('appShell'),pageHost=$('pageHost');

function esc(v){return String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;')}
function toast(message,type='success'){const el=$('toast');el.textContent=message;el.style.background=type==='error'?'#291010':'#0b3825';el.style.borderColor=type==='error'?'#814242':'#32805b';el.hidden=false;clearTimeout(el._t);el._t=setTimeout(()=>el.hidden=true,4200)}
function message(el,text,type='notice'){el.innerHTML=text?`<div class="${type}">${esc(text)}</div>`:''}
function pretty(value){return String(value??'').replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase())}
function money(value){if(value===null||value===undefined||value==='')return'';const n=Number(value);return Number.isFinite(n)?new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n):value}
function dateText(value){if(!value)return'—';const d=new Date(value.length===10?value+'T12:00:00':value);return Number.isNaN(d.getTime())?value:d.toLocaleDateString()}
function dateTime(value){if(!value)return'—';const d=new Date(value);return Number.isNaN(d.getTime())?value:d.toLocaleString()}
function roleLabel(role){return({joint_super_admin:'Joint Super Administrator',successor_trustee:'Successor Trustee',family_admin:'Family Administrator',family_viewer:'Family Viewer',youth_viewer:'Youth Viewer',professional_limited:'Professional Limited'})[role]||pretty(role)}
function isAdmin(){return['joint_super_admin','family_admin'].includes(currentProfile?.role)}
function isFounder(){return founderSeats.some(s=>s.user_id===currentUser?.id&&s.active)}
function settingValue(key,fallback){const raw=settings[key];return raw===undefined?fallback:raw}
function actionInUrl(){const h=new URLSearchParams(location.hash.replace(/^#/,''));const q=new URLSearchParams(location.search);const t=h.get('type')||q.get('type');return t==='invite'||t==='recovery'}
function closeModal(id){$(id).hidden=true}
document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>closeModal(b.dataset.close)));
document.querySelectorAll('.modal-backdrop').forEach(m=>m.addEventListener('click',e=>{if(e.target===m&&m.id!=='deviceModal')m.hidden=true}));

function renderNav(){const nav=$('nav');nav.innerHTML=MODULES.map(m=>`<button data-module="${m.key}" class="${m.key===currentModule?'active':''}"><span class="nav-icon">${m.icon}</span>${esc(m.title)}</button>`).join('');nav.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>navigate(b.dataset.module)))}
async function navigate(key){currentModule=key;renderNav();const m=MODULE_MAP[key];$('pageTitle').textContent=m.title;$('pageDescription').textContent=m.description;await renderPage(m);scrollTo({top:0,behavior:'smooth'})}

function showLogin(){authShell.hidden=false;appShell.hidden=true;$('loginForm').hidden=false;$('passwordForm').hidden=true;$('authSubtitle').textContent='Private Family Operating System · Production v2.0';initCaptcha()}
function showPasswordSetup(){authShell.hidden=false;appShell.hidden=true;$('loginForm').hidden=true;$('passwordForm').hidden=false;$('authSubtitle').textContent='Activate or recover your private account'}
function initCaptcha(){if(!CONFIG.turnstileSiteKey)return;const host=$('captchaHost');host.hidden=false;const render=()=>{if(captchaWidgetId!==null||!window.turnstile)return;captchaWidgetId=window.turnstile.render('#turnstileWidget',{sitekey:CONFIG.turnstileSiteKey,theme:'dark',callback:token=>{captchaToken=token},'expired-callback':()=>{captchaToken=null}})};render();if(captchaWidgetId===null)setTimeout(render,700)}
function resetCaptcha(){captchaToken=null;if(window.turnstile&&captchaWidgetId!==null)window.turnstile.reset(captchaWidgetId)}

$('loginForm').addEventListener('submit',async e=>{e.preventDefault();message($('authMessage'),'');const email=$('loginEmail').value.trim();const password=$('loginPassword').value;if(CONFIG.turnstileSiteKey&&!captchaToken)return message($('authMessage'),'Complete the security check first.','error');const credentials={email,password};if(captchaToken)credentials.options={captchaToken};const {error}=await sb.auth.signInWithPassword(credentials);resetCaptcha();if(error){message($('authMessage'),error.message,'error')}});
$('forgotBtn').addEventListener('click',async()=>{const email=$('loginEmail').value.trim();if(!email)return message($('authMessage'),'Enter your email address first.','error');if(CONFIG.turnstileSiteKey&&!captchaToken)return message($('authMessage'),'Complete the security check first.','error');const options={redirectTo:CONFIG.siteUrl};if(captchaToken)options.captchaToken=captchaToken;const {error}=await sb.auth.resetPasswordForEmail(email,options);resetCaptcha();if(error)message($('authMessage'),error.message,'error');else message($('authMessage'),'A reset email was sent if the account is authorized.')});
$('passwordForm').addEventListener('submit',async e=>{e.preventDefault();const p=$('newPassword').value,c=$('confirmPassword').value;if(p.length<16)return message($('authMessage'),'Use at least 16 characters.','error');if(p!==c)return message($('authMessage'),'The passwords do not match.','error');const {error}=await sb.auth.updateUser({password:p});if(error)return message($('authMessage'),error.message,'error');history.replaceState({},document.title,location.pathname);const {data}=await sb.auth.getSession();if(data.session)await openApp(data.session)});
$('logoutBtn').addEventListener('click',async()=>{await logEvent('logout','authentication','User signed out');await sb.auth.signOut()});

async function loadCore(){
  const [{data:profile,error:pErr},{data:settingRows},{data:seats}]=await Promise.all([
    sb.from('family_profiles').select('*').eq('id',currentUser.id).maybeSingle(),
    sb.from('app_settings').select('setting_key,setting_value'),
    sb.from('joint_authority_seats').select('*').order('seat_key')
  ]);
  if(pErr||!profile)throw new Error(pErr?.message||'The Family OS profile could not be loaded.');
  currentProfile=profile;settings=Object.fromEntries((settingRows||[]).map(r=>[r.setting_key,r.setting_value]));founderSeats=seats||[];
  $('accountName').textContent=profile.full_name||profile.preferred_name||'Authorized Family Member';$('accountEmail').textContent=currentUser.email||profile.email||'';$('accountRole').textContent=roleLabel(profile.role);
}

function startIdleProtection(){const minutes=Number(settingValue('session_idle_minutes',CONFIG.defaultIdleMinutes));const reset=()=>{clearTimeout(idleTimer);idleTimer=setTimeout(async()=>{await logEvent('automatic_logout','session',`${minutes} minutes without activity`);await sb.auth.signOut();alert('Your Family OS session ended after inactivity.')},minutes*60*1000)};['click','keydown','touchstart','mousemove'].forEach(evt=>addEventListener(evt,reset,{passive:true}));reset()}
function getDeviceId(){let id=localStorage.getItem('scl-device-id');if(!id){id=crypto.randomUUID?crypto.randomUUID():`${Date.now()}-${Math.random()}`;localStorage.setItem('scl-device-id',id)}return id}
async function registerRecognizedDevice(){const deviceId=getDeviceId();await sb.from('device_sessions').upsert({user_id:currentUser.id,device_id:deviceId,device_name:navigator.platform||'Browser device',user_agent:navigator.userAgent,platform:navigator.platform||'',last_seen_at:new Date().toISOString(),verification_status:'recognized'},{onConflict:'user_id,device_id'});await logEvent('login','authentication',`Device ${deviceId.slice(0,8)} recognized`,deviceId)}
async function enforceDeviceSecurity(){const required=Boolean(settingValue('require_new_device_verification',false));if(!required){await registerRecognizedDevice();return true}const deviceId=getDeviceId();const {data,error}=await sb.functions.invoke('device-security',{body:{action:'start',device_id:deviceId,device_name:navigator.platform||'Browser device',user_agent:navigator.userAgent}});if(error)throw new Error(`New-device verification is enabled, but the device-security function failed: ${error.message}`);if(data?.trusted)return true;pendingDeviceId=deviceId;$('deviceModal').hidden=false;return false}
$('verifyDeviceBtn').addEventListener('click',async()=>{const code=$('deviceCode').value.trim();message($('deviceMessage'),'');if(!/^\d{6}$/.test(code))return message($('deviceMessage'),'Enter the six-digit code.','error');const {data,error}=await sb.functions.invoke('device-security',{body:{action:'confirm',device_id:pendingDeviceId,code}});if(error||!data?.trusted)return message($('deviceMessage'),error?.message||data?.error||'Verification failed.','error');$('deviceModal').hidden=true;toast('This device is verified.');await finishOpeningApp()});

async function openApp(session){currentUser=session.user;await loadCore();authShell.hidden=true;appShell.hidden=false;renderNav();startIdleProtection();const trusted=await enforceDeviceSecurity();if(trusted)await finishOpeningApp()}
async function finishOpeningApp(){try{await sb.from('family_profiles').update({last_login_at:new Date().toISOString(),last_seen_at:new Date().toISOString()}).eq('id',currentUser.id)}catch(_){ }await navigate(currentModule)}

async function logEvent(action,target,details,deviceId=null){if(!currentUser)return;try{await sb.from('audit_log').insert({user_id:currentUser.id,user_email:currentUser.email,action,target,details,device_id:deviceId,user_agent:navigator.userAgent})}catch(_){}}

async function renderPage(module){pageHost.innerHTML='<div class="panel"><span class="loading"></span> Loading…</div>';try{if(module.special==='dashboard')return renderDashboard();if(module.special==='vault')return renderVault(false);if(module.special==='documents')return renderVault(true);if(module.special==='admin')return renderAdmin();if(module.special==='security')return renderSecurity();if(module.special==='backups')return renderBackups();if(module.special==='annual')return renderAnnualReview();return renderGeneric(module)}catch(error){pageHost.innerHTML=`<div class="error">${esc(error.message)}</div>`}}

async function getRecords(moduleKey=null){let q=sb.from('os_records').select('*').order('updated_at',{ascending:false});if(moduleKey)q=q.eq('module',moduleKey);const {data,error}=await q;if(error)throw error;return data||[]}
async function getDocuments(){const {data,error}=await sb.from('family_documents').select('*').order('created_at',{ascending:false});if(error)throw error;return data||[]}
async function getApprovals(entityType,ids){if(!ids.length||!isAdmin())return[];const {data}=await sb.from('record_approvals').select('*').eq('entity_type',entityType).in('entity_id',ids);return data||[]}
function approvalSummary(approvals,id){const rows=approvals.filter(a=>a.entity_id===id);return {approved:rows.filter(a=>a.decision==='approved').length,rejected:rows.filter(a=>a.decision==='rejected').length,mine:rows.find(a=>a.approver_user_id===currentUser.id)}}

async function renderDashboard(){const [records,docs,notices,reviewItems]=await Promise.all([getRecords(),getDocuments(),sb.from('app_notifications').select('*').is('read_at',null).order('created_at',{ascending:false}).limit(6).then(r=>r.data||[]),sb.from('annual_review_items').select('*').eq('review_year',new Date().getFullYear()).then(r=>r.data||[])]);currentRecords=records;currentDocuments=docs;const activeDocs=docs.filter(d=>['active','executed'].includes(d.document_status)).length,pending=docs.filter(d=>d.approval_state==='pending').length,upcoming=[...records.map(r=>({title:r.title,date:r.review_date||r.expiration_date,type:'Record'})),...docs.map(d=>({title:d.title,date:d.review_date||d.expiration_date,type:'Document'}))].filter(x=>x.date).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,8);const done=reviewItems.filter(i=>i.completed).length;pageHost.innerHTML=`
  <section class="hero"><div class="eyebrow">Scott · Louis-Scott Family</div><h2>Built so the next generation never has to start from zero.</h2><p class="lead">The private headquarters for family governance, the Trust, businesses, assets, records, security, history, knowledge, traditions, and succession.</p><div class="quote">We are not building wealth so our children never have to work. We are building systems so they never have to start from zero.</div></section>
  <h3 class="section-title">System Overview</h3><div class="grid-3"><div class="metric"><strong>${records.length}</strong><span>Structured Family OS records</span></div><div class="metric"><strong>${activeDocs}</strong><span>Active or executed documents</span></div><div class="metric"><strong>${pending}</strong><span>Items awaiting joint approval</span></div><div class="metric"><strong>${founderSeats.filter(s=>s.user_id&&s.active).length}/2</strong><span>Joint Authority seats activated</span></div><div class="metric"><strong>${done}/${reviewItems.length}</strong><span>${new Date().getFullYear()} annual-review items complete</span></div><div class="metric"><strong>${notices.length}</strong><span>Unread notifications</span></div></div>
  <h3 class="section-title">Joint Authority</h3><div class="grid">${founderSeats.map(s=>`<div class="card"><h3>${esc(s.full_name)}</h3><p>${s.user_id?'Account activated':'Founder seat reserved — account not yet bound'}</p><div class="meta"><span class="chip chip-green">Equal Joint Authority</span><span class="chip">${s.locked?'Locked seat':'Unlocked'}</span></div></div>`).join('')}</div>
  <h3 class="section-title">Upcoming Reviews & Expirations</h3>${upcoming.length?`<div class="table-wrap"><table class="data-table"><thead><tr><th>Item</th><th>Type</th><th>Date</th></tr></thead><tbody>${upcoming.map(x=>`<tr><td>${esc(x.title)}</td><td>${x.type}</td><td>${dateText(x.date)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">No review or expiration dates are currently scheduled.</div>'}
  ${notices.length?`<h3 class="section-title">Notifications</h3><div class="grid">${notices.map(n=>`<div class="card"><h3>${esc(n.title)}</h3><p>${esc(n.message)}</p><span class="small">${dateTime(n.created_at)}</span></div>`).join('')}</div>`:''}`;
}

async function renderGeneric(module){const records=await getRecords(module.key);currentRecords=records;const approvals=await getApprovals('record',records.map(r=>r.id));pageHost.innerHTML=`<section class="panel"><div class="eyebrow">Family OS Module</div><h2>${esc(module.title)}</h2><p class="lead">${esc(module.description)}</p>${module.highlights?`<div class="grid" style="margin-top:18px">${module.highlights.map(h=>`<div class="card"><h3>${esc(h)}</h3></div>`).join('')}</div>`:''}<div class="toolbar"><div class="toolbar-group"><input id="moduleSearch" type="search" placeholder="Search this section"><select id="moduleStatus"><option value="">All statuses</option>${['active','draft','pending_approval','executed','superseded','historical','archived','rejected'].map(s=>`<option value="${s}">${pretty(s)}</option>`).join('')}</select></div>${isAdmin()?'<button class="btn btn-primary" id="addRecordBtn">Add Record</button>':''}</div><div class="records" id="recordGrid"></div><div class="empty" id="recordEmpty" hidden>No authorized records are in this section yet.</div></section>`;renderRecordCards(records,approvals,module);$('moduleSearch').addEventListener('input',()=>filterModuleRecords(module,approvals));$('moduleStatus').addEventListener('change',()=>filterModuleRecords(module,approvals));if($('addRecordBtn'))$('addRecordBtn').addEventListener('click',()=>openRecordModal(module))}
function filterModuleRecords(module,approvals){const term=$('moduleSearch').value.trim().toLowerCase(),status=$('moduleStatus').value;const list=currentRecords.filter(r=>(!status||r.status===status)&&`${r.title} ${r.summary} ${r.record_type} ${JSON.stringify(r.data)}`.toLowerCase().includes(term));renderRecordCards(list,approvals,module)}
function renderRecordCards(records,approvals,module){const grid=$('recordGrid');if(!grid)return;grid.innerHTML='';$('recordEmpty').hidden=records.length!==0;records.forEach(r=>{const a=approvalSummary(approvals,r.id),el=document.createElement('article');el.className='record-card';el.innerHTML=`<h3>${esc(r.title)}</h3><p>${esc(r.summary||'No summary entered.')}</p><div class="meta"><span class="chip">${pretty(r.record_type)}</span><span class="chip ${r.status==='active'?'chip-green':r.status==='rejected'?'chip-red':'chip-blue'}">${pretty(r.status)}</span><span class="chip">${pretty(r.access_level)}</span>${r.requires_dual_approval?`<span class="chip">Approvals ${a.approved}/2</span>`:''}</div><div class="actions"><button class="btn btn-secondary" data-action="view">View</button>${isAdmin()?'<button class="btn btn-ghost" data-action="edit">Edit</button>':''}${isFounder()&&r.requires_dual_approval?'<button class="btn btn-green" data-action="approve">Approve</button><button class="btn btn-danger" data-action="reject">Reject</button>':''}</div>`;el.querySelector('[data-action=view]').addEventListener('click',()=>showRecordDetail(r,a));el.querySelector('[data-action=edit]')?.addEventListener('click',()=>openRecordModal(module,r));el.querySelector('[data-action=approve]')?.addEventListener('click',()=>submitApproval('record',r.id,'approved'));el.querySelector('[data-action=reject]')?.addEventListener('click',()=>submitApproval('record',r.id,'rejected'));grid.appendChild(el)})}
function showRecordDetail(record,approval){$('detailModalTitle').textContent=record.title;const rows=[['Module',pretty(record.module)],['Type',pretty(record.record_type)],['Status',pretty(record.status)],['Access',pretty(record.access_level)],['Approval',pretty(record.approval_state)],['Effective date',dateText(record.effective_date)],['Review date',dateText(record.review_date)],['Expiration date',dateText(record.expiration_date)],['Summary',record.summary||'—'],...Object.entries(record.data||{}).map(([k,v])=>[pretty(k),typeof v==='object'?JSON.stringify(v):v])];$('detailModalBody').innerHTML=`<dl class="detail-list">${rows.map(([k,v])=>`<dt>${esc(k)}</dt><dd>${esc(v??'—')}</dd>`).join('')}</dl>${record.requires_dual_approval?`<div class="notice" style="margin-top:18px">Joint approvals: ${approval.approved}/2 · Rejections: ${approval.rejected}</div>`:''}`;$('detailModal').hidden=false}
function inputField(id,label,type='text',value=''){if(type==='textarea')return`<div class="field wide"><label for="${id}">${esc(label)}</label><textarea id="${id}">${esc(value)}</textarea></div>`;return`<div class="field"><label for="${id}">${esc(label)}</label><input id="${id}" type="${type}" value="${esc(value)}"></div>`}
function openRecordModal(module,record=null){editingRecord=record;$('recordModalTitle').textContent=record?`Edit ${module.title} Record`:`Add ${module.title} Record`;const data=record?.data||{};$('recordFormFields').innerHTML=`<div class="field"><label>Record type</label><select id="rfType">${module.recordTypes.map(t=>`<option value="${t}" ${record?.record_type===t?'selected':''}>${pretty(t)}</option>`).join('')}</select></div><div class="field"><label>Status</label><select id="rfStatus">${['draft','active','pending_approval','executed','historical','archived'].map(s=>`<option value="${s}" ${record?.status===s?'selected':''}>${pretty(s)}</option>`).join('')}</select></div><div class="field wide"><label>Title</label><input id="rfTitle" value="${esc(record?.title||'')}" required></div><div class="field wide"><label>Summary</label><textarea id="rfSummary">${esc(record?.summary||'')}</textarea></div><div class="field"><label>Access level</label><select id="rfAccess">${(isFounder()?['joint_admin_only','trustee_confidential','family_internal','family_history','youth','professional_limited']:['trustee_confidential','family_internal','family_history','youth','professional_limited']).map(x=>`<option value="${x}" ${record?.access_level===x?'selected':''}>${pretty(x)}</option>`).join('')}</select></div><div class="field"><label>Requires both Joint Authorities</label><select id="rfDual"><option value="false">No</option><option value="true" ${(record?.requires_dual_approval??module.dualDefault)?'selected':''}>Yes</option></select></div>${inputField('rfEffective','Effective date','date',record?.effective_date||'')}${inputField('rfReview','Review date','date',record?.review_date||'')}${inputField('rfExpiration','Expiration date','date',record?.expiration_date||'')}${module.fields.map(([key,label,type])=>inputField('data_'+key,label,type,data[key]??'')).join('')}`;$('recordModal').hidden=false}
$('recordForm').addEventListener('submit',async e=>{e.preventDefault();const module=MODULE_MAP[currentModule],data={};module.fields.forEach(([key,,type])=>{let v=$('data_'+key)?.value??'';if(type==='number'&&v!=='')v=Number(v);data[key]=v});const payload={module:module.key,record_type:$('rfType').value,title:$('rfTitle').value.trim(),summary:$('rfSummary').value.trim(),status:$('rfStatus').value,access_level:$('rfAccess').value,requires_dual_approval:$('rfDual').value==='true',effective_date:$('rfEffective').value||null,review_date:$('rfReview').value||null,expiration_date:$('rfExpiration').value||null,data,updated_by:currentUser.id};let error;if(editingRecord){({error}=await sb.from('os_records').update(payload).eq('id',editingRecord.id))}else{payload.created_by=currentUser.id;({error}=await sb.from('os_records').insert(payload))}if(error)return toast(error.message,'error');closeModal('recordModal');toast('Record saved.');await navigate(currentModule)});

async function submitApproval(entityType,entityId,decision){if(!isFounder())return;const comment=prompt(`${pretty(decision)} comment (optional):`)||null;const {error}=await sb.from('record_approvals').upsert({entity_type:entityType,entity_id:entityId,approver_user_id:currentUser.id,decision,comment,decided_at:new Date().toISOString()},{onConflict:'entity_type,entity_id,approver_user_id'});if(error)return toast(error.message,'error');toast(`Decision recorded: ${pretty(decision)}.`);await navigate(currentModule)}

async function renderVault(registerOnly){const docs=await getDocuments();currentDocuments=docs;const approvals=await getApprovals('document',docs.map(d=>d.id));pageHost.innerHTML=`<section class="panel"><div class="eyebrow">${registerOnly?'Master Metadata Index':'Protected Files'}</div><h2>${registerOnly?'Document Register':'Private Family Vault'}</h2><p class="lead">${registerOnly?'Control active, executed, pending, superseded, historical, expired, and archived documents from one master register.':'Files remain in a private Supabase bucket and open through temporary signed links.'}</p><div class="warning">Never place the Supabase secret key, service-role key, database password, raw passwords, or full private documents in the public GitHub repository.</div><div class="toolbar"><div class="toolbar-group"><input id="docSearch" type="search" placeholder="Search documents"><select id="docStatus"><option value="">All statuses</option>${['uploading','pending_approval','active','executed','superseded','historical','expired','rejected','upload_failed'].map(s=>`<option value="${s}">${pretty(s)}</option>`).join('')}</select></div>${isAdmin()?'<button class="btn btn-primary" id="uploadDocBtn">Upload Document</button>':''}</div><div class="records" id="docGrid"></div><div class="empty" id="docEmpty" hidden>No authorized documents are listed.</div></section>`;renderDocCards(docs,approvals);$('docSearch').addEventListener('input',()=>filterDocs(approvals));$('docStatus').addEventListener('change',()=>filterDocs(approvals));$('uploadDocBtn')?.addEventListener('click',()=>openDocumentModal())}
function filterDocs(approvals){const term=$('docSearch').value.trim().toLowerCase(),status=$('docStatus').value;renderDocCards(currentDocuments.filter(d=>(!status||d.document_status===status)&&`${d.title} ${d.category} ${d.document_number} ${d.version_number} ${d.notes}`.toLowerCase().includes(term)),approvals)}
function renderDocCards(docs,approvals){const grid=$('docGrid');grid.innerHTML='';$('docEmpty').hidden=docs.length!==0;docs.forEach(d=>{const a=approvalSummary(approvals,d.id),el=document.createElement('article');el.className='doc-card';el.innerHTML=`<h3>${esc(d.title)}</h3><p>${esc(d.notes||d.original_file_name||'Private document')}</p><div class="meta"><span class="chip">${esc(d.document_number||'No ID')}</span><span class="chip">v${esc(d.version_number)}</span><span class="chip ${['active','executed'].includes(d.document_status)?'chip-green':d.document_status==='rejected'?'chip-red':'chip-blue'}">${pretty(d.document_status)}</span><span class="chip">${pretty(d.access_level)}</span>${d.requires_dual_approval?`<span class="chip">Approvals ${a.approved}/2</span>`:''}</div><div class="actions"><button class="btn btn-secondary" data-action="open">Open Securely</button><button class="btn btn-ghost" data-action="view">Metadata</button>${isAdmin()?'<button class="btn btn-ghost" data-action="version">New Version</button>':''}${isFounder()&&d.requires_dual_approval?'<button class="btn btn-green" data-action="approve">Approve</button><button class="btn btn-danger" data-action="reject">Reject</button>':''}</div>`;el.querySelector('[data-action=open]').addEventListener('click',()=>openSecureDocument(d));el.querySelector('[data-action=view]').addEventListener('click',()=>showDocumentDetail(d,a));el.querySelector('[data-action=version]')?.addEventListener('click',()=>openDocumentModal(d));el.querySelector('[data-action=approve]')?.addEventListener('click',()=>submitApproval('document',d.id,'approved'));el.querySelector('[data-action=reject]')?.addEventListener('click',()=>submitApproval('document',d.id,'rejected'));grid.appendChild(el)})}
function showDocumentDetail(d,a){$('detailModalTitle').textContent=d.title;const rows=[['Document ID',d.document_number],['Version',d.version_number],['Category',d.category],['Status',pretty(d.document_status)],['Access',pretty(d.access_level)],['Approval',pretty(d.approval_state)],['Original filename',d.original_file_name],['MIME type',d.mime_type],['Size',d.file_size?`${Math.round(d.file_size/1024)} KB`:'—'],['SHA-256 checksum',d.checksum_sha256],['Effective date',dateText(d.effective_date)],['Executed date',dateText(d.executed_date)],['Review date',dateText(d.review_date)],['Expiration date',dateText(d.expiration_date)],['Uploaded by',d.uploaded_by],['Created',dateTime(d.created_at)],['Notes',d.notes]];$('detailModalBody').innerHTML=`<dl class="detail-list">${rows.map(([k,v])=>`<dt>${esc(k)}</dt><dd>${esc(v||'—')}</dd>`).join('')}</dl>${d.requires_dual_approval?`<div class="notice" style="margin-top:18px">Joint approvals: ${a.approved}/2 · Rejections: ${a.rejected}</div>`:''}`;$('detailModal').hidden=false}
async function openSecureDocument(d){const seconds=Number(settingValue('signed_link_seconds',CONFIG.defaultSignedSeconds));const {data,error}=await sb.storage.from(CONFIG.bucket).createSignedUrl(d.file_path,seconds);if(error)return toast(error.message,'error');await logEvent('document_opened',d.title,`Signed link created for ${d.file_path}`);window.open(data.signedUrl,'_blank','noopener,noreferrer')}
function nextVersion(v){const parts=String(v||'1.0').split('.').map(Number);return `${Number.isFinite(parts[0])?parts[0]:1}.${Number.isFinite(parts[1])?parts[1]+1:1}`}
function openDocumentModal(source=null){versionSource=source;$('documentModalTitle').textContent=source?'Upload New Document Version':'Upload Private Document';$('documentModalMessage').innerHTML='';$('documentFormFields').innerHTML=`<div class="field wide"><label>Title</label><input id="dfTitle" value="${esc(source?.title||'')}" required></div><div class="field"><label>Document number</label><input id="dfNumber" value="${esc(source?.document_number||'')}" placeholder="SCL-FOS-02"></div><div class="field"><label>Version</label><input id="dfVersion" value="${esc(source?nextVersion(source.version_number):'1.0')}" required></div><div class="field"><label>Category</label><select id="dfCategory">${['Trust','Governance','LLC & Business','Assets','Insurance','Financial Administration','Family Members','Family History','Legacy Book','Traditions & Recipes','Education','Emergency Continuity','Digital Estate','Family Meetings','Goals & Projects','Backups','Annual Review','Other'].map(x=>`<option ${source?.category===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Access level</label><select id="dfAccess">${(isFounder()?['joint_admin_only','trustee_confidential','family_internal','family_history','youth','professional_limited']:['trustee_confidential','family_internal','family_history','youth','professional_limited']).map(x=>`<option value="${x}" ${source?.access_level===x?'selected':''}>${pretty(x)}</option>`).join('')}</select></div><div class="field"><label>Requires both Joint Authorities</label><select id="dfDual"><option value="false">No</option><option value="true" ${source?.requires_dual_approval?'selected':''}>Yes</option></select></div><div class="field"><label>Effective date</label><input id="dfEffective" type="date"></div><div class="field"><label>Executed date</label><input id="dfExecuted" type="date"></div><div class="field"><label>Review date</label><input id="dfReview" type="date"></div><div class="field"><label>Expiration date</label><input id="dfExpiration" type="date"></div><div class="field wide"><label>Notes</label><textarea id="dfNotes"></textarea></div><div class="field wide"><label>Select file</label><input id="dfFile" type="file" required></div>`;$('documentModal').hidden=false}
async function sha256(file){const hash=await crypto.subtle.digest('SHA-256',await file.arrayBuffer());return Array.from(new Uint8Array(hash)).map(b=>b.toString(16).padStart(2,'0')).join('')}
$('documentForm').addEventListener('submit',async e=>{e.preventDefault();const file=$('dfFile').files[0];if(!file)return;const btn=$('documentSubmitBtn');btn.disabled=true;btn.textContent='Securing document…';message($('documentModalMessage'),'');let metadataId=null;try{const id=crypto.randomUUID(),clean=file.name.normalize('NFKD').replace(/[^a-zA-Z0-9._-]+/g,'-').replace(/-+/g,'-'),path=`documents/${new Date().getFullYear()}/${id}-${clean}`,requires=$('dfDual').value==='true',checksum=await sha256(file);const payload={id,title:$('dfTitle').value.trim(),document_number:$('dfNumber').value.trim()||null,version_number:$('dfVersion').value.trim(),category:$('dfCategory').value,file_path:path,access_level:$('dfAccess').value,uploaded_by:currentUser.email,document_status:'uploading',requires_dual_approval:requires,approval_state:requires?'pending':'not_required',effective_date:$('dfEffective').value||null,executed_date:$('dfExecuted').value||null,review_date:$('dfReview').value||null,expiration_date:$('dfExpiration').value||null,original_file_name:file.name,mime_type:file.type||'application/octet-stream',file_size:file.size,checksum_sha256:checksum,notes:$('dfNotes').value.trim()||null,supersedes_document_id:versionSource?.id||null,created_by:currentUser.id,updated_by:currentUser.id};const {error:metaError}=await sb.from('family_documents').insert(payload);if(metaError)throw metaError;metadataId=id;const {error:uploadError}=await sb.storage.from(CONFIG.bucket).upload(path,file,{cacheControl:'3600',upsert:false,contentType:file.type||undefined});if(uploadError){await sb.from('family_documents').update({document_status:'upload_failed',notes:`${payload.notes||''} Upload error: ${uploadError.message}`.trim()}).eq('id',id);throw uploadError}const finalStatus=requires?'pending_approval':(payload.executed_date?'executed':'active');const {error:finishError}=await sb.from('family_documents').update({document_status:finalStatus}).eq('id',id);if(finishError)throw finishError;await logEvent('document_uploaded',payload.title,`${path} | SHA-256 ${checksum}`);closeModal('documentModal');toast(requires?'Document uploaded and awaiting both approvals.':'Document uploaded to the private vault.');await navigate(currentModule)}catch(error){message($('documentModalMessage'),error.message,'error');if(metadataId)console.warn('Document metadata retained with failure status:',metadataId)}finally{btn.disabled=false;btn.textContent='Upload Securely'}});

async function renderAdmin(){if(!isFounder())return pageHost.innerHTML='<div class="error">Administration is limited to the two Joint Authority accounts.</div>';const [{data:profiles},{data:invites},{data:seats}]=await Promise.all([sb.from('family_profiles').select('*').order('created_at'),sb.from('allowed_invites').select('*').order('created_at',{ascending:false}),sb.from('joint_authority_seats').select('*').order('seat_key')]);founderSeats=seats||[];pageHost.innerHTML=`<section class="panel"><div class="eyebrow">Restricted Administration</div><h2>Joint Authority & User Administration</h2><div class="warning">Only the two locked founder seats may hold Joint Super Administrator authority. Binding or changing a founder seat is a major governance action and should be supported by the proper written record.</div><h3 class="section-title">Joint Authority Seats</h3><div class="grid">${founderSeats.map(s=>`<div class="card"><h3>${esc(s.full_name)}</h3><p>${esc(s.email||'Email not bound')}</p><div class="meta"><span class="chip chip-green">Equal Joint Authority</span><span class="chip">${s.user_id?'Activated':'Reserved'}</span></div>${s.seat_key==='caprice'&&!s.email?'<button class="btn btn-primary" id="bindCapriceBtn">Bind Caprice’s Email</button>':''}</div>`).join('')}</div><h3 class="section-title">Invite an Authorized User</h3><form id="inviteForm"><div class="form-grid"><div class="field"><label>Full name</label><input id="inviteName" required></div><div class="field"><label>Email</label><input id="inviteEmail" type="email" required></div><div class="field"><label>Role</label><select id="inviteRole">${['successor_trustee','family_admin','family_viewer','youth_viewer','professional_limited'].map(r=>`<option value="${r}">${roleLabel(r)}</option>`).join('')}</select></div><div class="field"><label>Access expiration (optional)</label><input id="inviteExpiry" type="datetime-local"></div><div class="field wide"><label>Notes</label><textarea id="inviteNotes"></textarea></div></div><button class="btn btn-primary" type="submit">Approve & Send Invitation</button></form><div id="inviteMessage"></div><h3 class="section-title">Current Accounts</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Expiration</th><th>Action</th></tr></thead><tbody>${(profiles||[]).map(p=>`<tr><td>${esc(p.full_name||'—')}</td><td>${esc(p.email)}</td><td>${roleLabel(p.role)}</td><td>${pretty(p.status)}</td><td>${dateTime(p.access_expires_at)}</td><td>${founderSeats.some(s=>s.user_id===p.id)?'<span class="chip chip-green">Locked founder</span>':`<button class="btn btn-ghost" data-profile="${p.id}" data-status="${p.status}">${p.status==='active'?'Suspend':'Restore'}</button>`}</td></tr>`).join('')}</tbody></table></div><h3 class="section-title">Invite Register</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Expires</th></tr></thead><tbody>${(invites||[]).map(i=>`<tr><td>${esc(i.email)}</td><td>${roleLabel(i.role)}</td><td>${pretty(i.status)}</td><td>${dateTime(i.expires_at)}</td></tr>`).join('')}</tbody></table></div></section>`;$('inviteForm').addEventListener('submit',sendInvite);$('bindCapriceBtn')?.addEventListener('click',bindCaprice);document.querySelectorAll('[data-profile]').forEach(b=>b.addEventListener('click',()=>toggleProfile(b.dataset.profile,b.dataset.status)))}
async function sendInvite(e){e.preventDefault();const body={email:$('inviteEmail').value.trim(),full_name:$('inviteName').value.trim(),role:$('inviteRole').value,expires_at:$('inviteExpiry').value?new Date($('inviteExpiry').value).toISOString():null,notes:$('inviteNotes').value.trim()||null};message($('inviteMessage'),'');const {data,error}=await sb.functions.invoke('invite-user',{body});if(!error&&data?.success){message($('inviteMessage'),'Invitation approved and sent.');e.target.reset();return renderAdmin()}const {error:dbError}=await sb.from('allowed_invites').upsert({...body,approved_by:currentUser.email,status:'approved',updated_at:new Date().toISOString()},{onConflict:'email'});if(dbError)return message($('inviteMessage'),dbError.message,'error');message($('inviteMessage'),'The invite was approved in the Family OS. The invite-user Edge Function is not deployed yet, so send the email from Supabase → Authentication → Users → Send invitation.','warning');await renderAdmin()}
async function bindCaprice(){const email=prompt('Enter Caprice B. Louis-Scott’s exact invitation email:')?.trim().toLowerCase();if(!email)return;const {error}=await sb.from('joint_authority_seats').update({email}).eq('seat_key','caprice');if(error)return toast(error.message,'error');await sb.from('allowed_invites').upsert({email,full_name:'Caprice B. Louis-Scott',role:'joint_super_admin',approved_by:currentUser.email,status:'approved'},{onConflict:'email'});const {data:existing}=await sb.from('family_profiles').select('id').ilike('email',email).maybeSingle();if(existing?.id){const {error:seatError}=await sb.from('joint_authority_seats').update({user_id:existing.id}).eq('seat_key','caprice');if(seatError)return toast(seatError.message,'error');const {error:profileError}=await sb.from('family_profiles').update({role:'joint_super_admin',status:'active'}).eq('id',existing.id);if(profileError)return toast(profileError.message,'error');toast('Caprice’s existing account is now bound to the locked founder seat.');return renderAdmin()}const {data:inviteData,error:inviteError}=await sb.functions.invoke('invite-user',{body:{email,full_name:'Caprice B. Louis-Scott',role:'joint_super_admin'}});if(!inviteError&&inviteData?.success)toast('Caprice’s founder seat is reserved and her invitation was sent.');else toast('Caprice’s founder seat is reserved. Send the invitation from Supabase Authentication if the invite Edge Function is not deployed.');await renderAdmin()}
async function toggleProfile(id,status){const next=status==='active'?'suspended':'active',reason=next==='suspended'?(prompt('Suspension reason:')||'Administrative suspension'):null;const {error}=await sb.from('family_profiles').update({status:next,suspended_reason:reason}).eq('id',id);if(error)return toast(error.message,'error');toast(`Account ${next}.`);await renderAdmin()}

async function renderSecurity(){if(!isFounder())return pageHost.innerHTML='<div class="error">Full security and audit records are limited to the Joint Authority accounts.</div>';const [{data:logs},{data:devices}]=await Promise.all([sb.from('audit_log').select('*').order('created_at',{ascending:false}).limit(100),sb.from('device_sessions').select('*').order('last_seen_at',{ascending:false})]);const deviceRequired=Boolean(settingValue('require_new_device_verification',false));pageHost.innerHTML=`<section class="panel"><div class="eyebrow">Security Administration</div><h2>Security & Audit</h2><div class="grid"><div class="card"><h3>Invite-Only Access</h3><p>No public self-registration. Every account must be approved.</p></div><div class="card"><h3>30-Minute Inactivity Logout</h3><p>Website session timer: ${Number(settingValue('session_idle_minutes',30))} minutes.</p></div><div class="card"><h3>New-Device Verification</h3><p>${deviceRequired?'Enforced through the device-security Edge Function.':'Capability installed but not enforced until email delivery and Edge Function secrets are configured.'}</p>${isFounder()?`<button class="btn ${deviceRequired?'btn-danger':'btn-green'}" id="toggleDeviceSecurity">${deviceRequired?'Disable':'Enable'} Enforcement</button>`:''}</div><div class="card"><h3>Signed Document Links</h3><p>Private links expire after ${Number(settingValue('signed_link_seconds',60))} seconds.</p></div></div><h3 class="section-title">Recognized Devices</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>User</th><th>Device</th><th>Status</th><th>First Seen</th><th>Last Seen</th></tr></thead><tbody>${(devices||[]).map(d=>`<tr><td>${esc(d.user_id)}</td><td>${esc(d.device_name||d.platform||d.device_id)}</td><td>${pretty(d.verification_status)}${d.revoked_at?' / Revoked':''}</td><td>${dateTime(d.first_seen_at)}</td><td>${dateTime(d.last_seen_at)}</td></tr>`).join('')}</tbody></table></div><h3 class="section-title">Recent Audit Activity</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Target</th><th>Details</th></tr></thead><tbody>${(logs||[]).map(l=>`<tr><td>${dateTime(l.created_at)}</td><td>${esc(l.user_email||'system')}</td><td>${pretty(l.action)}</td><td>${esc(l.target||'')}</td><td>${esc(l.details||'')}</td></tr>`).join('')}</tbody></table></div></section>`;$('toggleDeviceSecurity')?.addEventListener('click',async()=>{if(!confirm(`${deviceRequired?'Disable':'Enable'} new-device verification? Enable only after the device-security Edge Function and Resend email secrets are deployed.`))return;const {error}=await sb.from('app_settings').update({setting_value:!deviceRequired,updated_by:currentUser.id}).eq('setting_key','require_new_device_verification');if(error)return toast(error.message,'error');settings.require_new_device_verification=!deviceRequired;toast('Security setting updated.');await renderSecurity()})}

async function renderBackups(){if(!isFounder())return pageHost.innerHTML='<div class="error">Backup administration is limited to the Joint Authority accounts.</div>';const {data}=await sb.from('backup_records').select('*').order('backup_date',{ascending:false});pageHost.innerHTML=`<section class="panel"><div class="eyebrow">Continuity & Recovery</div><h2>Backup Register</h2><p class="lead">Record database exports, private-vault copies, encrypted offline copies, verification, and restore tests. Supabase Storage does not provide native object versioning, so document versions are preserved through separate file paths and metadata records.</p><div class="warning">A backup is not complete until it has been verified, stored away from the production account, and periodically restore-tested.</div><button class="btn btn-primary" id="addBackupBtn">Record Completed Backup</button><div class="table-wrap" style="margin-top:18px"><table class="data-table"><thead><tr><th>Date</th><th>Type</th><th>Location</th><th>Verified</th><th>Restore Tested</th><th>Notes</th></tr></thead><tbody>${(data||[]).map(b=>`<tr><td>${dateTime(b.backup_date)}</td><td>${pretty(b.backup_type)}</td><td>${esc(b.location_description)}</td><td>${b.verified?'Yes':'No'}</td><td>${b.restore_tested?'Yes':'No'}</td><td>${esc(b.notes||'')}</td></tr>`).join('')}</tbody></table></div><h3 class="section-title">Required Backup Layers</h3><div class="grid"><div class="card"><h3>Production</h3><p>Supabase database and private Storage bucket.</p></div><div class="card"><h3>Encrypted Offline</h3><p>Encrypted external drive stored in a secure location.</p></div><div class="card"><h3>Approved Cloud Copy</h3><p>Encrypted backup separate from the production account.</p></div><div class="card"><h3>Fireproof Binder</h3><p>Current controlling paper documents and master register.</p></div></div></section>`;$('addBackupBtn').addEventListener('click',addBackup)}
async function addBackup(){const type=prompt('Backup type (database, vault, complete, binder):')?.trim();if(!type)return;const location=prompt('Secure location description (do not enter passwords or secret keys):')?.trim();if(!location)return;const verified=confirm('Was this backup verified?');const restore=confirm('Was a restore test completed?');const notes=prompt('Notes (optional):')||null;const {error}=await sb.from('backup_records').insert({backup_type:type,location_description:location,verified,verified_at:verified?new Date().toISOString():null,restore_tested:restore,restore_tested_at:restore?new Date().toISOString():null,completed_by:currentUser.id,notes});if(error)return toast(error.message,'error');toast('Backup record added.');await renderBackups()}

async function renderAnnualReview(){const year=new Date().getFullYear();const {data,error}=await sb.from('annual_review_items').select('*').eq('review_year',year).order('category').order('title');if(error)throw error;const items=data||[],done=items.filter(i=>i.completed).length,pct=items.length?Math.round(done/items.length*100):0;pageHost.innerHTML=`<section class="panel"><div class="eyebrow">${year} Governance Cycle</div><h2>Annual Family OS Review</h2><p class="lead">Complete one coordinated review each year so the digital system, controlling documents, binder, access roles, and family intentions stay aligned.</p><div class="progress"><span style="width:${pct}%"></span></div><p>${done} of ${items.length} items complete · ${pct}%</p><div style="display:grid;gap:10px">${items.map(i=>`<label class="check-row ${i.completed?'completed':''}"><input type="checkbox" data-review="${i.id}" ${i.completed?'checked':''} ${isAdmin()?'':'disabled'}><span><strong style="color:var(--gold2)">${esc(i.title)}</strong><br><span class="small">${esc(i.category)} · ${esc(i.description||'')}</span>${i.completed?`<br><span class="small">Completed ${dateTime(i.completed_at)}</span>`:''}</span></label>`).join('')}</div></section>`;document.querySelectorAll('[data-review]').forEach(c=>c.addEventListener('change',async()=>{const completed=c.checked;const {error}=await sb.from('annual_review_items').update({completed,completed_by:completed?currentUser.id:null,completed_at:completed?new Date().toISOString():null}).eq('id',c.dataset.review);if(error){c.checked=!completed;return toast(error.message,'error')}await renderAnnualReview()}))}

$('globalSearch').addEventListener('keydown',async e=>{if(e.key!=='Enter')return;e.preventDefault();const term=e.target.value.trim().toLowerCase();if(!term)return;const [records,docs]=await Promise.all([getRecords(),getDocuments()]);const rr=records.filter(r=>`${r.title} ${r.summary} ${r.module} ${r.record_type} ${JSON.stringify(r.data)}`.toLowerCase().includes(term)),dd=docs.filter(d=>`${d.title} ${d.category} ${d.document_number} ${d.notes}`.toLowerCase().includes(term));$('pageTitle').textContent='Search Results';$('pageDescription').textContent=`Results for “${term}”`;pageHost.innerHTML=`<section class="panel"><h2>Global Search</h2><h3 class="section-title">Records (${rr.length})</h3>${rr.length?`<div class="records">${rr.map(r=>`<div class="record-card"><h3>${esc(r.title)}</h3><p>${esc(r.summary||'')}</p><button class="btn btn-secondary" data-search-record="${r.id}">Open</button></div>`).join('')}</div>`:'<div class="empty">No matching records.</div>'}<h3 class="section-title">Documents (${dd.length})</h3>${dd.length?`<div class="records">${dd.map(d=>`<div class="doc-card"><h3>${esc(d.title)}</h3><p>${esc(d.document_number||'')}</p><button class="btn btn-secondary" data-search-doc="${d.id}">Open Securely</button></div>`).join('')}</div>`:'<div class="empty">No matching documents.</div>'}</section>`;document.querySelectorAll('[data-search-record]').forEach(b=>b.addEventListener('click',()=>{const r=rr.find(x=>x.id===b.dataset.searchRecord);showRecordDetail(r,{approved:0,rejected:0})}));document.querySelectorAll('[data-search-doc]').forEach(b=>b.addEventListener('click',()=>openSecureDocument(dd.find(x=>x.id===b.dataset.searchDoc))))});

sb.auth.onAuthStateChange(async(event,session)=>{if(event==='PASSWORD_RECOVERY')return showPasswordSetup();if(!session){currentUser=null;currentProfile=null;clearTimeout(idleTimer);return showLogin()}if(actionInUrl())return showPasswordSetup();try{await openApp(session)}catch(error){authShell.hidden=false;appShell.hidden=true;message($('authMessage'),error.message,'error')}});
(async()=>{if(actionInUrl())showPasswordSetup();const {data}=await sb.auth.getSession();if(data.session&&!actionInUrl()){try{await openApp(data.session)}catch(error){message($('authMessage'),error.message,'error');showLogin()}}else if(!data.session&&!actionInUrl())showLogin()})();
</script>
</body>
</html>
